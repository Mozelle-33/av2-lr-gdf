# The PC-Wiener classifier unit alone (same recipe as synth_yosys.ys), with
# the core's ASIC token depth (MSTG = 1, FIP = 0: NTOK = 23); the threshold
# RAMs and the class ROM are memory macros.
read_verilog /mnt/g/AV2/rtl/gdf_core.v
blackbox gdf_ram_sdp gdf_ram_lut gdf_rom_pcw gdf_rom_sel
chparam -set AW 10 -set NTOK 23 -set CPR 3 -set MSTG 1 gdf_pcw
hierarchy -check -top gdf_pcw
synth -top gdf_pcw -flatten -booth
dfflibmap -liberty /root/work/asic/NangateOpenCellLibrary_typical.lib
abc -D 2500 -liberty /root/work/asic/NangateOpenCellLibrary_typical.lib -script +strash;&get,-n;&fraig,-x;&put;scorr;dc2;dretime;strash;&get,-n;&dch,-f;&nf,-D,2500;&put;buffer;upsize,-D,2500;dnsize,-D,2500;stime,-p
opt_clean
tee -o /root/work/asic/pcw_unit/stat.txt stat -liberty /root/work/asic/NangateOpenCellLibrary_typical.lib
