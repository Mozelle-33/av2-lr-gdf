# Hierarchical variant of synth_yosys.ys for the joint LR/GDF core (VS = 1,
# PCW = 1, LR = 1, MSTG = 1): multipliers (gdf_mul, per parameterization) and
# the PC-Wiener unit stay modules, for an area breakdown.
read_verilog /mnt/g/AV2/rtl/gdf_core.v
blackbox gdf_ram_sdp gdf_ram_lut gdf_rom_pcw gdf_rom_sel
chparam -set MAXCH 1024 -set AW 10 -set MSTG 1 -set VS 1 -set PCW 1 -set LR 1 gdf_core
hierarchy -check -top gdf_core
synth -top gdf_core -booth
dfflibmap -liberty /root/work/asic/NangateOpenCellLibrary_typical.lib
abc -D 2500 -liberty /root/work/asic/NangateOpenCellLibrary_typical.lib
opt_clean
tee -o /root/work/asic/hier_joint/stat_hier.txt stat -liberty /root/work/asic/NangateOpenCellLibrary_typical.lib
