+static void tcas_dump_lrc_none(const RestorationUnitInfo *rui, int width,
+                               int height, int procunit_width,
+                               const uint16_t *src, int src_stride,
+                               const uint16_t *dst, int dst_stride,
+                               int bit_depth, int v_start, int h_start,
+                               int ss_x, int ss_y) {
+  const int bv = 2, bh = 2, lb = WIENERNS_UV_BRD;
+  const int n_pu = (width + procunit_width - 1) / procunit_width;
+  const AV2_COMMON *cm = rui->cm;
+  const int32_t hdr[24] = {
+    rui->plane,
+    0,
+    width,
+    height,
+    procunit_width,
+    bit_depth,
+    rui->base_qindex,
+    rui->qindex_offset,
+    cm ? (int32_t)cm->current_frame.display_order_hint : -1,
+    v_start,
+    h_start,
+    bv,
+    bh,
+    lb,
+    n_pu,
+    cm ? cm->cur_frame->buf.uv_width : -1,
+    cm ? cm->cur_frame->buf.uv_height : -1,
+    ss_x,
+    ss_y,
+    cm ? cm->seq_params.cfl_ds_filter_index : -1,
+    cm ? cm->features.has_lossless_segment : -1,
+    1,
+    0,
+    tcas_lrc_frame
+  };
+  FILE *f = tcas_lrcoff_dump;
+  static const uint16_t zeros16[4096];
+  fwrite("LRSC", 1, 4, f);
+  fwrite(hdr, sizeof(hdr), 1, f);
+  fwrite(zeros16, sizeof(int32_t), n_pu, f);
+  for (int r = -bv; r < height + bv; r++)
+    fwrite(src + r * src_stride - bh, sizeof(uint16_t), width + 2 * bh, f);
+  for (int r = -lb; r < height + lb; r++)
+    fwrite(zeros16, sizeof(uint16_t), width + 2 * lb, f);
+  fwrite(zeros16, sizeof(int16_t), WIENERNS_TAPS_MAX, f);
+  for (int r = 0; r < height; r++)
+    fwrite(dst + r * dst_stride, sizeof(uint16_t), width, f);
+}
