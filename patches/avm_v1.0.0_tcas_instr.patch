+  }
+  if (!tcas_timing_on) return;
+  const double tot = tcas_time[TCAS_T_WRAPUP];
+  fprintf(stderr, "[tcas] frames: %ld\n", tcas_frames);
+  for (int i = 0; i < TCAS_T_NUM; i++) {
+    fprintf(stderr, "[tcas] %-22s %10.3f ms %7.2f %%\n", tcas_names[i],
+            1e3 * tcas_time[i], tot > 0 ? 100.0 * tcas_time[i] / tot : 0.0);
+  }
