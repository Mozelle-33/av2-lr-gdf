+static void tcas_report(void) {
+  if (tcas_gdf_dump) {
+    fclose(tcas_gdf_dump);
+    tcas_gdf_dump = NULL;
+  }
+  if (tcas_gdfoff_dump) {
+    fclose(tcas_gdfoff_dump);
