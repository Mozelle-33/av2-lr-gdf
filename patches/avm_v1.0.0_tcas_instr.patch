diff --git a/av2/common/tcas_instr.h b/av2/common/tcas_instr.h
new file mode 100644
index 0000000..b8de1e9
--- /dev/null
+++ b/av2/common/tcas_instr.h
@@ -0,0 +1,133 @@
+/*
+ * Instrumentation for the LR/GDF hardware study (not part of AVM).
+ *
+ * Compiled in only when TCAS_INSTR is defined (build with
+ * -DCMAKE_C_FLAGS=-DTCAS_INSTR=1). At run time it is controlled by:
+ *   AVM_STAGE_TIMING=1      print per-stage decoder timing at exit (stderr)
+ *   AVM_GDF_DUMP=<path>     write one record per GDF processing unit
+ *   AVM_GDF_DUMP_MAXFRAMES  only dump the first N frames that use GDF
+ *   AVM_GDFOFF_DUMP=<path>  the units of those frames with GDF off (block
+ *                           flag or local mode), same record layout with
+ *                           err = 0 and lr = out
+ *
+ * Dump record layout (little endian), see analysis/gdf_dump.py:
+ *   char     magic[4] = "GDFU"
+ *   int32    header[16] = { frame_idx, order_hint, frame_w, frame_h,
+ *                           bit_depth, i_min, i_max, j_min, j_max,
+ *                           qp_idx, ref_dst_idx, pxl_shift, scale_val,
+ *                           err_shift, has_lossless, apron }
+ *   uint16   win[(h + 2*apron) * (w + 2*apron)]  guided input incl. apron
+ *   int16    err[h * w]                          expected error (pre-scale)
+ *   uint16   lr[h * w]                           LR output (before GDF)
+ *   uint16   out[h * w]                          final output (after GDF)
+ * with h = i_max - i_min and w = j_max - j_min.
+ *
+ *   AVM_PCW_DUMP=<path>     write one record per luma PC-Wiener processing
+ *                           unit (LR), see analysis/pcw_dump.py:
+ *   char     magic[4] = "PCWU"
+ *   int32    header[12] = { width, height, bit_depth, tskip_zero_flag,
+ *                           classify_only, qindex (base + offset),
+ *                           border_v, border_h, mi_rows, mi_cols,
+ *                           frame_order_hint, reserved }
+ *   uint16   dgd[(height + 2*border_v) * (width + 2*border_h)]
+ *   uint8    tskip[mi_rows * mi_cols]            transform-skip flags
+ *   uint8    class_id[mi_rows * mi_cols]         PC-Wiener class per 4x4
+ *   int32    qval_lut[256 * 4]                   qval_given_tskip_lut
+ * with mi_rows = ceil(height / 4) and mi_cols = ceil(width / 4).
+ *
+ *   AVM_LR_DUMP=<path>      write one record per luma LR stripe of a
+ *                           restoration unit (PC-Wiener or Wiener-NS), taken
+ *                           right after the stripe filter, see
+ *                           analysis/lr_golden.py:
+ *   char     magic[4] = "LRSU"
+ *   int32    header[24] = { rtype, width, height, procunit_width, bit_depth,
+ *                           base_qindex, qindex_offset, set_index,
+ *                           num_classes, skip_pcwiener_filtering,
+ *                           tskip_zero_flag, order_hint, v_start, h_start,
+ *                           border_v, border_h, mi_rows, mi_cols, n_pu,
+ *                           class_id_restrict, compute_classification,
+ *                           frame_w, frame_h, has_lossless_segment }
+ *   int32    pu_type[n_pu]                        local_rest_type per PU
+ *   uint16   dgd[(height + 2*border_v) * (width + 2*border_h)]
+ *   uint8    tskip[mi_rows * mi_cols]
+ *   uint8    class_id[mi_rows * mi_cols]
+ *   int32    qval_lut[256 * 4]
+ *   int16    taps[16 * 32]                        Wiener-NS taps per class
+ *   uint16   dst[height * width]                  LR output
+ *
+ *   AVM_LRC_DUMP=<path>     chroma LR (cross-component Wiener-NS), two
+ *                           record types, see analysis/lrc_golden.py:
+ *   char     magic[4] = "LRSC"   one per chroma LR stripe of a restoration
+ *                                unit, right after the stripe filter
+ *   int32    header[24] = { plane, rtype, width, height, procunit_width,
+ *                           bit_depth, base_qindex, qindex_offset,
+ *                           order_hint, v_start, h_start, border_v,
+ *                           border_h, luma_border, n_pu, frame_w, frame_h,
+ *                           ss_x, ss_y, ds_type, has_lossless_segment,
+ *                           num_classes, has_luma, reserved }
+ *   int32    pu_type[n_pu]                        local_rest_type per PU
+ *   uint16   dgd[(height + 2*border_v) * (width + 2*border_h)]
+ *   uint16   luma[(height + 2*luma_border) * (width + 2*luma_border)]
+ *                                                 down-sampled luma as used
+ *   int16    taps[32]                             Wiener-NS taps (class 0)
+ *   uint16   dst[height * width]                  LR output
+ *   char     magic[4] = "LRSL"   one per luma stripe of the down-sampled
+ *                                luma of cross-component Wiener-NS
+ *   int32    header[16] = { order_hint, frame_stripe, y0, y1, width_y,
+ *                           height_y, width_uv, height_uv, ds_type, ss_x,
+ *                           ss_y, h_uv, above, below, bit_depth, reserved }
+ *   uint16   src[(2*h_uv) * (2*width_uv)]         luma rows read, starting
+ *                                                 at y0 - 4*above
+ *   uint16   ds[h_uv * width_uv]                  down-sampled rows
+ *
+ *   AVM_LRCOFF_DUMP=<path>  the chroma restoration unit stripes with LR off
+ *                           (RESTORE_NONE) of the frames with chroma LR, as
+ *                           "LRSC" records with rtype 0, has_luma 0, zero
+ *                           luma and taps, dgd = the frame samples around
+ *                           the unit, dst = dgd, and reserved = the index of
+ *                           the frame: the number of LRSL records with
+ *                           frame_stripe 0 before it, minus one
+ */
+#ifndef AVM_AV2_COMMON_TCAS_INSTR_H_
+#define AVM_AV2_COMMON_TCAS_INSTR_H_
+
+#if TCAS_INSTR
+#include <stdio.h>
+
+enum {
+  TCAS_T_TILES,       // entropy decoding + reconstruction
+  TCAS_T_DEBLOCK,     // deblocking
+  TCAS_T_CDEF,        // CDEF
+  TCAS_T_CCSO,        // CCSO (incl. padded-copy preparation)
+  TCAS_T_GDF_COPY,    // copy of the GDF guided frame
+  TCAS_T_LR,          // loop restoration (incl. boundary line saving)
+  TCAS_T_GDF,         // GDF filtering (av2_gdf_frame_dec)
+  TCAS_T_GDF_LAP,     //   gradients + classes
+  TCAS_T_GDF_INF,     //   feature extraction + MAC + table lookup
+  TCAS_T_GDF_COMP,    //   scaling + clipping + write-back
+  TCAS_T_WRAPUP,      // whole av2_decode_tg_tiles_and_wrapup
+  TCAS_T_NUM
+};
+
+extern double tcas_time[TCAS_T_NUM];
+extern long tcas_frames;
+extern FILE *tcas_gdf_dump;
+extern FILE *tcas_pcw_dump;
+extern FILE *tcas_lr_dump;
+extern FILE *tcas_lrc_dump;
+extern FILE *tcas_lrcoff_dump;
+extern int tcas_timing_on;
+
+void tcas_instr_init(void);
+// Monotonic time in seconds (defined in gdf.c, which enables POSIX
+// declarations; AVM itself is compiled as strict C11).
+double tcas_now(void);
+
+#define TCAS_TIC(v) const double v = tcas_now()
+#define TCAS_TOC(stage, v) (tcas_time[(stage)] += tcas_now() - (v))
+#else
+#define TCAS_TIC(v)
+#define TCAS_TOC(stage, v)
+#endif  // TCAS_INSTR
+
+#endif  // AVM_AV2_COMMON_TCAS_INSTR_H_
