+#if TCAS_INSTR
+// TCAS study: one record per luma LR stripe of a restoration unit, taken
+// after the stripe filter while the stripe borders are still in place (see
+// tcas_instr.h).
+static void tcas_dump_lr_stripe(const RestorationUnitInfo *rui, int rtype,
+                                int width, int height, int procunit_width,
+                                const uint16_t *src, int src_stride,
+                                const uint16_t *dst, int dst_stride,
