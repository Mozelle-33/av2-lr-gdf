+void tcas_instr_init(void) {
+  static int inited = 0;
+  if (inited) return;
+  inited = 1;
+  const char *t = getenv("AVM_STAGE_TIMING");
+  tcas_timing_on = t && atoi(t) > 0;
+  const char *d = getenv("AVM_GDF_DUMP");
+  if (d && *d) {
+    tcas_gdf_dump = fopen(d, "wb");
+    if (!tcas_gdf_dump) fprintf(stderr, "[tcas] cannot open %s\n", d);
+  }
+  const char *go = getenv("AVM_GDFOFF_DUMP");
+  if (go && *go) {
+    tcas_gdfoff_dump = fopen(go, "wb");
+    if (!tcas_gdfoff_dump) fprintf(stderr, "[tcas] cannot open %s\n", go);
+  }
+  const char *pw = getenv("AVM_PCW_DUMP");
+  if (pw && *pw) {
+    tcas_pcw_dump = fopen(pw, "wb");
+    if (!tcas_pcw_dump) fprintf(stderr, "[tcas] cannot open %s\n", pw);
+  }
+  const char *lr = getenv("AVM_LR_DUMP");
+  if (lr && *lr) {
+    tcas_lr_dump = fopen(lr, "wb");
+    if (!tcas_lr_dump) fprintf(stderr, "[tcas] cannot open %s\n", lr);
+  }
+  const char *lrc = getenv("AVM_LRC_DUMP");
+  if (lrc && *lrc) {
+    tcas_lrc_dump = fopen(lrc, "wb");
+    if (!tcas_lrc_dump) fprintf(stderr, "[tcas] cannot open %s\n", lrc);
+  }
+  const char *lrco = getenv("AVM_LRCOFF_DUMP");
+  if (lrco && *lrco) tcas_lrcoff_dump = fopen(lrco, "wb");
+  const char *m = getenv("AVM_GDF_DUMP_MAXFRAMES");
+  if (m && *m) tcas_dump_max_frames = atol(m);
+  atexit(tcas_report);
+}
+
+static uint16_t *tcas_copy_unit(const uint16_t *rec, int stride, int i_min,
+                                int i_max, int j_min, int j_max) {
+  const int h = i_max - i_min, w = j_max - j_min;
+  uint16_t *buf = (uint16_t *)malloc(sizeof(*buf) * h * w);
+  for (int r = 0; r < h; r++)
+    memcpy(buf + r * w, rec + (i_min + r) * stride + j_min, sizeof(*buf) * w);
+  return buf;
+}
+
+static void tcas_dump_unit(const AV2_COMMON *cm, int i_min, int i_max,
+                           int j_min, int j_max, int qp_idx, int ref_dst_idx,
+                           int pxl_shift, int scale_val, int err_shift,
+                           const uint16_t *lr_copy) {
+  // lr_copy == NULL: unit with GDF off (AVM_GDFOFF_DUMP), expected error 0
+  // and LR output = final output
+  const int h = i_max - i_min, w = j_max - j_min;
+  const int apron = GDF_TEST_EXTRA_VER_BORDER;
+  const int32_t hdr[16] = { (int32_t)tcas_gdf_frame_idx,
+                            (int32_t)cm->current_frame.display_order_hint,
+                            cm->cur_frame->buf.y_width,
+                            cm->cur_frame->buf.y_height,
+                            cm->cur_frame->buf.bit_depth,
+                            i_min,
+                            i_max,
+                            j_min,
+                            j_max,
+                            qp_idx,
+                            ref_dst_idx,
+                            pxl_shift,
+                            scale_val,
+                            err_shift,
+                            cm->features.has_lossless_segment,
+                            apron };
+  FILE *f = lr_copy ? tcas_gdf_dump : tcas_gdfoff_dump;
+  fwrite("GDFU", 1, 4, f);
+  fwrite(hdr, sizeof(hdr), 1, f);
+  const int s = cm->gdf_info.inp_stride;
+  for (int r = i_min - apron; r < i_max + apron; r++)
+    fwrite(cm->gdf_info.inp_ptr + r * s + j_min - apron, sizeof(uint16_t),
+           w + 2 * apron, f);
+  const uint16_t *rec = cm->cur_frame->buf.buffers[AVM_PLANE_Y];
+  const int rs = cm->cur_frame->buf.y_stride;
+  if (lr_copy) {
+    for (int r = 0; r < h; r++)
+      fwrite(cm->gdf_info.err_ptr + r * cm->gdf_info.err_stride,
+             sizeof(int16_t), w, f);
+    fwrite(lr_copy, sizeof(uint16_t), (size_t)h * w, f);
+  } else {
+    const int16_t zero = 0;
+    for (int k = 0; k < h * w; k++) fwrite(&zero, sizeof(zero), 1, f);
+    for (int r = i_min; r < i_max; r++)
+      fwrite(rec + r * rs + j_min, sizeof(uint16_t), w, f);
+  }
+  for (int r = i_min; r < i_max; r++)
+    fwrite(rec + r * rs + j_min, sizeof(uint16_t), w, f);
+}
