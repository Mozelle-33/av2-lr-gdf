+  const int mi_rows = (height + 3) >> 2, mi_cols = (width + 3) >> 2;
+  const int n_pu = (width + procunit_width - 1) / procunit_width;
+  const AV2_COMMON *cm = rui->cm;
+  const int32_t hdr[24] = {
+    rtype,
+    width,
+    height,
+    procunit_width,
+    bit_depth,
+    rui->base_qindex,
+    rui->qindex_offset,
+    get_filter_set_index(rui->base_qindex, rui->qindex_offset),
+    rui->wienerns_info.num_classes,
+    rui->skip_pcwiener_filtering,
+    rui->tskip_zero_flag,
+    cm ? (int32_t)cm->current_frame.display_order_hint : -1,
+    v_start,
+    h_start,
+    bv,
+    bh,
+    mi_rows,
+    mi_cols,
+    n_pu,
+    rui->wiener_class_id_restrict,
+    rui->compute_classification,
+    cm ? cm->cur_frame->buf.y_width : -1,
+    cm ? cm->cur_frame->buf.y_height : -1,
+    cm ? cm->features.has_lossless_segment : -1
+  };
+  FILE *f = tcas_lr_dump;
+  fwrite("LRSU", 1, 4, f);
+  fwrite(hdr, sizeof(hdr), 1, f);
+  const int mi_offset_y =
+      AVMMIN(height - 1, RESTORATION_UNIT_OFFSET) >> (MI_SIZE_LOG2 - rui->ss_y);
+  for (int p = 0; p < n_pu; p++) {
+    const int mi_offset_x =
+        (p * procunit_width) >> (MI_SIZE_LOG2 - rui->ss_x);
+    const int32_t t =
+        rui->mbmi_ptr[mi_offset_x + mi_offset_y * rui->mi_stride]
+            ->local_rest_type;
+    fwrite(&t, sizeof(t), 1, f);
+  }
+  for (int r = -bv; r < height + bv; r++)
+    fwrite(src + r * src_stride - bh, sizeof(uint16_t), width + 2 * bh, f);
+  static const uint8_t zeros[1024];
+  for (int r = 0; r < mi_rows; r++) {
+    if (rui->tskip)
+      fwrite(rui->tskip + r * rui->tskip_stride, 1, mi_cols, f);
+    else
+      fwrite(zeros, 1, mi_cols, f);
+  }
+  for (int r = 0; r < mi_rows; r++) {
+    if (rui->wiener_class_id)
+      fwrite(rui->wiener_class_id + r * rui->wiener_class_id_stride, 1,
+             mi_cols, f);
+    else
+      fwrite(zeros, 1, mi_cols, f);
+  }
+  fwrite(pcb->qval_given_tskip_lut, sizeof(int32_t), 256 * 4, f);
+  fwrite(rui->wienerns_info.allfiltertaps, sizeof(int16_t),
+         WIENERNS_MAX_CLASSES * WIENERNS_TAPS_MAX, f);
+  for (int r = 0; r < height; r++)
+    fwrite(dst + r * dst_stride, sizeof(uint16_t), width, f);
+  (void)bit_depth;
+}
